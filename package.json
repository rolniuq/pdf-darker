{
  "name": "pdf-darker",
  "version": "0.1.0",
  "private": true,
  "description": "Convert PDF files to dark mode with perfect text fidelity — UI + TUI",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "pdf-darker": "./packages/tui/dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node ./packages/ui/dist/server.js",
    "build": "pnpm -r build",
    "build:shared": "pnpm build -r --filter @pdf-darker/shared",
    "build:core": "pnpm build -r --filter @pdf-darker/core",
    "build:tui": "pnpm build -r --filter @pdf-darker/tui",
    "build:ui": "pnpm build -r --filter @pdf-darker/ui",
    "convert": "node ./packages/tui/dist/index.js",
    "server": "node ./packages/ui/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run tests/core",
    "lint": "tsc --noEmit",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "clean": "rm -rf packages/*/dist node_modules"
  },

  "devDependencies": {
    "@types/node": "^22.0.0",
    "mupdf": "^1.28.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
